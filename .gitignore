# Local secrets — keep API keys out of the public repo
.env
.env.*
!.env.example

# Reproducible dependencies and local runtime state
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.agent-cache/
.DS_Store
wandb/

# Downloaded source material stays local; the manifest pins reproducible contents.
data/docs/*
!data/docs/manifest.json
