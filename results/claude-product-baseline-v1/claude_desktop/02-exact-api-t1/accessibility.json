    "title": "",
    "value": "latest"
  },
  {
    "description": "",
    "index": 107,
    "role": "AXStaticText",
    "title": "",
    "value": " alias. Every object automatically has a "
  },
  {
    "description": "",
    "index": 109,
    "role": "AXStaticText",
    "title": "",
    "value": ":latest"
  },
  {
    "description": "",
    "index": 110,
    "role": "AXStaticText",
    "title": "",
    "value": " alias that points to the most recent version, which means the result changes each time you publish a new version of "
  },
  {
    "description": "",
    "index": 112,
    "role": "AXStaticText",
    "title": "",
    "value": "support_prompt"
  },
  {
    "description": "",
    "index": 113,
    "role": "AXStaticText",
    "title": "",
    "value": ". For anything where reproducibility matters, such as an evaluation or a production deployment, pin a version or use a custom alias. "
  },
  {
    "description": "coreweave",
    "index": 115,
    "role": "AXLink",
    "title": "",
    "url": "https://docs.coreweave.com/products/wandb/weave/guides/tracking/objects.md",
