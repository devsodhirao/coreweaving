    "value": "weave.ref(\"support_prompt:v3\").get()"
  },
  {
    "description": "",
    "index": 101,
    "role": "AXStaticText",
    "title": "",
    "value": " is pinned. It always returns version 3, no matter what you publish later. "
  },
  {
    "description": "",
    "index": 103,
    "role": "AXStaticText",
    "title": "",
    "value": "weave.ref(\"support_prompt\").get()"
  },
  {
    "description": "",
    "index": 104,
    "role": "AXStaticText",
    "title": "",
    "value": " follows the "
  },
  {
    "description": "",
    "index": 106,
