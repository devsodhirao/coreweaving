    "title": "",
    "value": "coreweave"
  },
  {
    "description": "",
    "index": 98,
    "role": "AXStaticText",
    "title": "",
    "value": "So "
  },
  {
    "description": "",
    "index": 100,
    "role": "AXStaticText",
