    "value": ". "
  },
  {
    "description": "",
    "index": 89,
    "role": "AXStaticText",
    "title": "",
    "value": "weave.ref([NAME]:[VERSION])"
  },
  {
    "description": "",
    "index": 90,
    "role": "AXStaticText",
    "title": "",
    "value": " retrieves the specified version and also requires "
  },
  {
    "description": "",
    "index": 92,
    "role": "AXStaticText",
    "title": "",
    "value": "weave.init(...)"
  },
  {
    "description": "",
    "index": 93,
    "role": "AXStaticText",
