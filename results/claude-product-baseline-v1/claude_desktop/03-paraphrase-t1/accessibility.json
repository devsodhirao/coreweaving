    "value": ""
  },
  {
    "description": "",
    "index": 203,
    "role": "AXStaticText",
    "title": "",
    "value": "Read docs.coreweave.com"
  },
  {
    "description": "",
    "index": 205,
    "role": "AXStaticText",
    "title": "",
    "value": "Use the "
  },
  {
    "description": "",
    "index": 207,
    "role": "AXStaticText",
    "title": "",
    "value": "postprocess_inputs"
  },
  {
    "description": "",
    "index": 208,
    "role": "AXStaticText",
    "title": "",
    "value": " and "
  },
  {
    "description": "",
    "index": 210,
    "role": "AXStaticText",
    "title": "",
    "value": "postprocess_output"
  },
  {
    "description": "",
    "index": 211,
    "role": "AXStaticText",
    "title": "",
    "value": " parameters on the "
  },
  {
    "description": "",
    "index": 213,
    "role": "AXStaticText",
    "title": "",
    "value": "@weave.op"
  },
  {
    "description": "",
    "index": 214,
    "role": "AXStaticText",
    "title": "",
    "value": " decorator. They change only what Weave logs: your function still receives the real arguments and runs exactly as written."
  },
  {
    "description": "",
    "index": 216,
    "role": "AXStaticText",
    "title": "",
    "value": "The two hooks work like this:"
  },
  {
    "description": "",
    "index": 222,
    "role": "AXStaticText",
    "title": "",
    "value": "postprocess_inputs"
  },
  {
    "description": "",
    "index": 223,
    "role": "AXStaticText",
    "title": "",
    "value": " receives a dict mapping argument names to their values and returns the dict that Weave should record."
  },
  {
    "description": "",
    "index": 228,
    "role": "AXStaticText",
    "title": "",
    "value": "postprocess_output"
  },
  {
    "description": "",
    "index": 229,
    "role": "AXStaticText",
    "title": "",
    "value": " receives whatever your function returned and returns the version that Weave should record."
  },
